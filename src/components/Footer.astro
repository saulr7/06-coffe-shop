---
import { navLinks, site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="bg-espresso text-latte">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-bold text-cream">{site.name}</p>
      <p class="mt-3 max-w-xs text-sm">{site.tagline}</p>
    </div>
    <div>
      <p class="font-semibold text-cream">Explore</p>
      <ul class="mt-4 space-y-2 text-sm">
        {navLinks.map((link) => (
          <li><a href={link.href} class="transition-colors hover:text-cream">{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-semibold text-cream">Contact</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>{site.address}</li>
        <li><a href={`tel:${site.phone}`} class="transition-colors hover:text-cream">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-cream">{site.email}</a></li>
        <li>{site.instagram}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cream/10 py-5 text-center text-xs">
    © {year} {site.name}. All rights reserved.
  </div>
</footer>
