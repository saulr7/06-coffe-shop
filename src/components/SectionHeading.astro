---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'center' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class="text-sm font-semibold uppercase tracking-widest text-caramel">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-bold md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-mocha">{description}</p>}
</div>
