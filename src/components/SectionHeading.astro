---
interface Props {
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { title, description, align = 'center' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <h2 class="text-balance text-3xl font-bold leading-tight tracking-tight md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-pretty text-lg text-mocha">{description}</p>}
</div>
