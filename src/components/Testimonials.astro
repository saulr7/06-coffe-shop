---
import SectionHeading from './SectionHeading.astro';
import { testimonials } from '../config/site';

const [lead, ...rest] = testimonials;
---

<section class="bg-espresso text-cream">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <SectionHeading align="left" title="Loved by the neighborhood" />
    <div class="mt-12 grid gap-12 md:grid-cols-5 md:gap-16">
      <figure class="md:col-span-3">
        <blockquote class="text-balance font-display text-2xl leading-snug md:text-3xl">“{lead.quote}”</blockquote>
        <figcaption class="mt-6">
          <span class="font-semibold">{lead.author}</span>
          <span class="block text-latte">{lead.role}</span>
        </figcaption>
      </figure>
      <div class="space-y-8 md:col-span-2 md:border-l md:border-latte/20 md:pl-10">
        {rest.map((t) => (
          <figure>
            <blockquote class="font-display text-lg leading-relaxed">“{t.quote}”</blockquote>
            <figcaption class="mt-3 text-sm">
              <span class="font-semibold">{t.author}</span>
              <span class="block text-latte">{t.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
