---
import { openingHours, site } from '../config/site';
---

<section class="bg-espresso text-cream">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="font-display text-[1.375rem] font-medium italic leading-snug text-caramel">Roasted in Tegucigalpa</p>
      <h1 class="mt-5 text-balance text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl">{site.tagline}</h1>
      <p class="mt-6 max-w-xl text-pretty text-lg text-latte md:text-xl">
        Single-origin beans, house-baked pastries and a corner table with your name on it.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/menu" class="press rounded-full bg-caramel px-7 py-3 font-medium text-espresso hover:bg-latte">
          See the menu
        </a>
        <a href="#visit" class="press rounded-full border border-latte/40 px-7 py-3 font-medium hover:border-latte/70 hover:bg-cream/10">
          Visit us
        </a>
      </div>
    </div>

    <dl class="mt-16 grid gap-x-12 gap-y-6 border-t border-latte/20 pt-8 sm:grid-cols-2 md:mt-20">
      <div>
        <dt class="text-sm text-latte/80">Find us</dt>
        <dd class="mt-1 text-lg">{site.address}</dd>
      </div>
      <div>
        <dt class="text-sm text-latte/80">{openingHours[0].days}</dt>
        <dd class="mt-1 text-lg tabular-nums">{openingHours[0].hours}</dd>
      </div>
    </dl>
  </div>
</section>
