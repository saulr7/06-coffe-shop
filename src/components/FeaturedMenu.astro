---
import SectionHeading from './SectionHeading.astro';
import MenuItemCard from './MenuItemCard.astro';
import { featuredItems } from '../config/menu';
---

<section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <SectionHeading
    title="What everyone orders"
    description="Our most-loved drinks and bakes, made fresh every morning."
  />
  <div class="mt-12 grid gap-x-12 md:grid-cols-2">
    {featuredItems.map((item) => <MenuItemCard item={item} />)}
  </div>
  <div class="mt-10 text-center">
    <a href="/menu" class="font-medium underline decoration-caramel decoration-2 underline-offset-4 hover:text-mocha">
      View full menu →
    </a>
  </div>
</section>
