---
import { navLinks, site } from '../config/site';
---

<header class="sticky top-0 z-30 border-b border-latte/70 bg-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <div class="flex items-center gap-10">
      <a href="/" class="font-display text-xl font-bold tracking-tight">
        {site.name}
      </a>

      <nav class="hidden items-center gap-8 text-sm font-medium md:flex" aria-label="Main">
        {navLinks.map((link) => (
          <a href={link.href} class="transition-colors hover:text-caramel">{link.label}</a>
        ))}
      </nav>
    </div>

    <a
      href="/menu"
      class="hidden rounded-full bg-espresso px-5 py-2 text-sm font-medium text-cream transition-colors hover:bg-mocha md:inline-block"
    >
      Order now
    </a>

    <button
      type="button"
      class="md:hidden rounded-md p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <nav class="hidden border-t border-latte/70 px-6 py-4 md:hidden" aria-label="Mobile" data-nav-panel>
    <ul class="flex flex-col gap-4 text-sm font-medium">
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  import '../scripts/mobile-nav';
</script>
