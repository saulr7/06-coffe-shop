---
import SectionHeading from './SectionHeading.astro';
import { openingHours, site } from '../config/site';
---

<section id="visit" class="scroll-mt-20 bg-latte/50">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <SectionHeading title="Pull up a chair" description="Come say hi — the kettle is always on." />
    <div class="mt-12 grid gap-12 md:grid-cols-2">
      <div class="rounded-2xl border border-mocha/20 p-8">
        <h3 class="text-xl font-bold">Opening hours</h3>
        <ul class="mt-5 divide-y divide-mocha/15">
          {openingHours.map((row) => (
            <li class="flex justify-between py-3">
              <span class="font-medium">{row.days}</span>
              <span class="tabular-nums text-mocha">{row.hours}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-mocha/20 p-8">
        <h3 class="text-xl font-bold">Find us</h3>
        <p class="mt-5 text-mocha">{site.address}</p>
        <p class="mt-2">
          <a href={`tel:${site.phone}`} class="hover:text-mocha">{site.phone}</a>
        </p>
        <p class="mt-1">
          <a href={`mailto:${site.email}`} class="hover:text-mocha">{site.email}</a>
        </p>
        <a
          href={`https://maps.google.com/?q=${encodeURIComponent(site.address)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-block rounded-full bg-espresso px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-mocha"
        >
          Get directions
        </a>
      </div>
    </div>
  </div>
</section>
