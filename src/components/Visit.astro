---
import SectionHeading from './SectionHeading.astro';
import { openingHours, site } from '../config/site';
---

<section id="visit" class="scroll-mt-20 bg-latte/50">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading eyebrow="Visit" title="Pull up a chair" description="Come say hi — the kettle is always on." />
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-latte bg-white/60 p-8">
        <h3 class="text-xl font-bold">Opening hours</h3>
        <ul class="mt-5 divide-y divide-latte">
          {openingHours.map((row) => (
            <li class="flex justify-between py-3 text-sm">
              <span class="font-medium">{row.days}</span>
              <span class="text-mocha">{row.hours}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-latte bg-white/60 p-8">
        <h3 class="text-xl font-bold">Find us</h3>
        <p class="mt-5 text-sm text-mocha">{site.address}</p>
        <p class="mt-2 text-sm">
          <a href={`tel:${site.phone}`} class="hover:text-caramel">{site.phone}</a>
        </p>
        <p class="mt-1 text-sm">
          <a href={`mailto:${site.email}`} class="hover:text-caramel">{site.email}</a>
        </p>
        <a
          href={`https://maps.google.com/?q=${encodeURIComponent(site.address)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-block rounded-full bg-espresso px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-mocha"
        >
          Get directions
        </a>
      </div>
    </div>
  </div>
</section>
