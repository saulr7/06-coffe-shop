---
import type { MenuItem } from '../types';
import { formatPrice } from '../utils/format';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<article class="menu-row border-b border-latte py-5">
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-xl font-bold">{item.name}</h3>
    <span class="menu-price font-semibold tabular-nums text-mocha">{formatPrice(item.price)}</span>
  </div>
  <p class="mt-1 max-w-prose text-mocha">{item.description}</p>
</article>
